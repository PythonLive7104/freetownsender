# EndTime — Docker deployment environment.
# Copy to .env on the server and fill in. Never commit the real .env.
#
#   cp .env.example .env && nano .env
#
# NOTE: this is the *root* .env, used by docker compose. backend/.env is only used
# when running the backend directly (without Docker) for local development.

# --- Database -------------------------------------------------------------
# Postgres runs as a container on this same server. It has no published port,
# so it is only reachable from inside the compose network.
POSTGRES_DB=endtime
POSTGRES_USER=endtime
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Host must be "db" — the compose service name, not localhost. Inside a container,
# localhost is that container itself.
# If the password contains @ : / or #, percent-encode it here (@ -> %40).
DATABASE_URL=postgresql://endtime:change-me-to-a-long-random-password@db:5432/endtime

# --- Django ---------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# Needed for admin logins once you put HTTPS in front. Scheme included.
CSRF_TRUSTED_ORIGINS=https://your-domain.com

# The SPA is served from the same origin as the API, so CORS is not exercised.
# Left here only for non-Docker dev.
CORS_ALLOWED_ORIGINS=https://your-domain.com

# --- Encryption -----------------------------------------------------------
# Fernet key encrypting mailbox & proxy passwords at rest.
# ⚠ If you already have data, COPY THE EXISTING VALUE from backend/.env.
#   A new key makes every stored credential permanently unreadable.
# Generate a fresh one only for a brand-new install:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MAIL_ENCRYPTION_KEY=change-me

# --- Networking -----------------------------------------------------------
# Port nginx binds on the host. Use 8080 if a reverse proxy already owns 80.
HTTP_PORT=80

# Interface to bind that port on. Leave as 0.0.0.0 when this container is the only
# thing serving the site. Behind a TLS proxy (see Caddyfile.example) set both
# HTTP_PORT=8080 and HTTP_BIND=127.0.0.1, so the unencrypted port is not exposed
# on the public IP.
HTTP_BIND=0.0.0.0
